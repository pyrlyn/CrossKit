<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode only loads sandboxed source editor extensions. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Shared container: settings (UserDefaults) and Mach lookup of the host bridge port "group.dev.pyrlyn.CrossKit.bridge". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.pyrlyn.CrossKit</string>
	</array>
</dict>
</plist>
